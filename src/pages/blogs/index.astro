---
import BackToPrev from "@components/BackToPrev.astro";
import HorizontalCard from "@components/HorizontalCard.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection } from "astro:content";


const blogs = (await getCollection("blogs"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())


---

<BaseLayout title="blog">
  <div class="pb-12 mt-5" id="blog">
    <div class="text-5xl font-bold"> Blog Posts {"✒️"}</div>
    <div class="py-2">
      <p class="">
        These are some of the blog posts I have written over time. Some are technical, while others are more personal.
      </p>
    </div>
  </div>


  <BackToPrev  variant="outline" className="mb-5" text="Back to home">
  </BackToPrev>
  
  {blogs.map(blog => (
    <HorizontalCard
    content={blog}
    />
  ))}
 
</BaseLayout>

<script></script>
