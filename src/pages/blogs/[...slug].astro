---
import BackToPrev from '@components/BackToPrev.astro';
import FormattedDate from '@components/FormattedDate.astro';
import Link from '@components/Link.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { readingTime } from '@lib/utils';
import { getCollection, type CollectionEntry } from 'astro:content';


export async function getStaticPaths() {
  const blogs = (await getCollection("blogs"))
    .filter(post => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return blogs.map((project) => ({
    params: { slug: project.slug },
    props: project,
  }));
}
type Props = CollectionEntry<"blogs">;

const blog = Astro.props;
const { Content } = await blog.render();
---

<BaseLayout title={blog.data.title} description={blog.data.description} image={`https://www.savamihai.com${blog.data.img}`} ogType="article">
  
    <div class="animate">
      <BackToPrev text='Back to blogs'>
        
      </BackToPrev>
    </div>
    <div class="space-y-1 my-10">
      <div class="animate flex items-center gap-1.5">
        <div class="font-base text-sm">
          <FormattedDate date={blog.data.date} />
        </div>
        &bull;
        <div class="font-base text-sm">
          {readingTime(blog.body)}
        </div>
      </div>
      <div class="animate text-2xl font-semibold text-black">
        {blog.data.title}
      </div>
        {(blog.data.demoURL || blog.data.liveURL) && (
          <nav class="animate flex gap-1">
          <span>Go to:</span>
          {blog.data.demoURL && (
            <Link href={blog.data.demoURL} external>
              Demo
            </Link>
          )}
          {blog.data.demoURL && blog.data.liveURL && (
            <span>/</span>
          )}
          {blog.data.liveURL && (
            <Link href={blog.data.liveURL} external>
              App
            </Link>
          )}
        </nav>
      )}
      
    </div>
    <article class="animate prose prose-slate max-w-none ">
      <Content />
    </article>
</BaseLayout>

