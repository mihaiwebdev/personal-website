---
import BackToPrev from '@components/BackToPrev.astro';
import FormattedDate from '@components/FormattedDate.astro';
import Link from '@components/Link.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { readingTime } from '@lib/utils';
import { getCollection, type CollectionEntry } from 'astro:content';



export async function getStaticPaths() {
  const apps = (await getCollection("apps"))
    .filter(post => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return apps.map((app) => ({
    params: { slug: app.slug },
    props: app,
  }));
}

type Props = CollectionEntry<"apps">;

const app = Astro.props;
const { Content } = await app.render();
---

<BaseLayout title={app.data.title} description={app.data.description}>
  
    <div class="animate">
      <BackToPrev text='Back to apps'>
        
      </BackToPrev>
    </div>
    <div class="space-y-1 my-10">
      <div class="animate flex items-center gap-1.5">
        <div class="font-base text-sm">
          <FormattedDate date={app.data.date} />
        </div>
        &bull;
        <div class="font-base text-sm">
          {readingTime(app.body)}
        </div>
      </div>
      <div class="animate text-2xl font-semibold text-black">
        {app.data.title}
      </div>
        {(app.data.demoURL || app.data.liveURL) && (
          <nav class="animate flex gap-1">
          <span>Go to:</span>
          {app.data.demoURL && (
            <Link href={app.data.demoURL} external>
              Demo
            </Link>
          )}
          {app.data.demoURL && app.data.liveURL && (
            <span>/</span>
          )}
          {app.data.liveURL && (
            <Link href={app.data.liveURL} external>
              App
            </Link>
          )}
        </nav>
      )}
      
    </div>
    <article class="animate prose prose-slate max-w-none font-semibold text-dark-600">
      <Content />
    </article>
</BaseLayout>

