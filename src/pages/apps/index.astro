---
import BackToPrev from "@components/BackToPrev.astro";
import HorizontalCard from "@components/HorizontalCard.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const apps = (await getCollection("apps"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
---

<BaseLayout title="apps">
  <div class="pb-12 mt-5" id="apps">
    <div class="text-5xl font-bold"> Apps {"🧑‍💻"}</div>
    <div class="py-2">
      <p class="">
        Here are some apps I've built to simplify tasks and enhance productivity.
        </p>
    </div>
  </div>


  <BackToPrev  variant="outline" className="mb-5" text="Back to home">
  </BackToPrev>
  
  {apps.map(apps => (
    <HorizontalCard
    content={apps}
    />
  ))}
  
</BaseLayout>

<script></script>
