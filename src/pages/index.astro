---
import Link from "@components/Link.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <div class="pb-12 mt-5" id="home">
    <div class="text-xl py-1">Hey there 👋</div>
    <div class="text-5xl font-bold">I'm Mihai</div>
    <div class="text-3xl py-3 font-bold">Full-Stack Developer</div>
    <div class="py-2">
      <p class="animate">
        I'm a Software Developer on the AI Innovation team at Marsh McLennan, and in my free time, I love building tools that make life easier, like:
        <span class="block">
          ✨ <Link href="https://video-repurpose.com">
            𝗩𝗶𝗱𝗲𝗼-𝗥𝗲𝗽𝘂𝗿𝗽𝗼𝘀𝗲.𝗰𝗼𝗺
          </Link>
          – Convert your videos into blogs, newsletters, and social media posts in minutes. 
        </span>
        <span class="block">
          🎬 <Link href="https://moviepicker.app">𝗠𝗼𝘃𝗶𝗲𝗣𝗶𝗰𝗸𝗲𝗿.𝗮𝗽𝗽</Link> 
           – Find a movie to watch in seconds, not hours. 
        </span>

        
    </div>
  </div>

  <div>
    <div id="projects" class="text-3xl w-full font-bold mb-2">
      My Apps {"</>"}
    </div>
  </div>

  <HorizontalCard
    title="Video Repurpose"
    img="/video-repurpose-cta.png"
    desc="Video Repurpose helps Youtube content creators to maximize their reach by converting their videos into engaging blogs, newsletters, and social media posts in minutes."
    url="/projects/video-repurpose"
    badge="NEW!"
    badgeColor="bg-blue-500"
    badgeTextcolor="text-white"
    badgeAnimation="animate-bounce"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Movie Picker"
    img="/movie-picker.png"
    desc=`Movie Picker is completly FREE and it's scope is to help movie lovers to find a Movie or TV Series to watch Fast!
    You can discover top-rated movies and TV shows to watch on your favorite streaming platform, based on your mood or genres that matches your current vibe.`
    url="/projects/movie-picker"
    badge="FREE"
  />
 
  <div class="mt-12">
    <div id="projects" class="flex justify-between items-end w-full  mb-2">
      <span class="font-bold text-3xl">
        Side Projects {"🧑‍💻"}
      </span>

      <div class=" text-lg text-gray-600 font-bold  animate-pulse">
        <Link href="/projects" >See all projects</Link>
      </div>
    </div>
  </div>

  
  <HorizontalCard
    title="Recipe Finder - AI-Powered"
    img="/recipe-finder.png"
    desc="A Next.js app where you just describe what you want to eat, and AI gives you 5 recipe ideas with images to match."
    url="https://www.youtube.com/watch?v=fwmlO7JydyM"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Pathfinding Visualizer App"
    img="/pathfinding-1.png"
    desc="Developed an interactive visual interface for demonstrating three search algorithms, featuring maze generation, mouse-enabled wall drawing, adjustable start and end points, and pathfinding algorithm selection"
    url="https://celadon-monstera-509a49.netlify.app/"
  />

  
  <!-- <div class="mt-5">
    <CvSection />
  </div> -->
</BaseLayout>

<script></script>
