---
import Link from "@components/Link.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import CvSection from "@components/CvSection.astro";

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0,3)

  const apps = (await getCollection("apps"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

  const blogs = (await getCollection("blogs"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
---

<BaseLayout>
  <div class="pb-12 mt-5 animate" id="home">
    <div class="text-xl py-1 ">Hey there 👋</div>
    <div class="text-5xl font-bold ">I'm Mihai</div>
    <div class="text-3xl py-3 font-bold ">Full-Stack Developer</div>
    <div class="py-2">
      <p class="">
        I'm part of the AI Innovation team at Marsh McLennan, and I love building tools that make life easier, like:
        <span class="block">
          ✨ <Link href="https://video-repurpose.com">
            𝗩𝗶𝗱𝗲𝗼-𝗥𝗲𝗽𝘂𝗿𝗽𝗼𝘀𝗲.𝗰𝗼𝗺
          </Link>
          – Convert your videos into blogs, newsletters, and social media posts in minutes. 
        </span>
        <span class="block">
          🎬 <Link href="https://moviepicker.xyz">𝗠𝗼𝘃𝗶𝗲𝗣𝗶𝗰𝗸𝗲𝗿.xyz</Link> 
           – Find a movie to watch in seconds, not hours. 
        </span>
    </div>
  </div>

  <div class="animate">
    <div id="apps" class="flex justify-between items-end w-full mb-2">
      <span class="font-bold text-2xl sm:text-3xl">
        My Apps {"</>"}
      </span>
        
      <div class=" text-lg text-gray-600 font-bold">
        <Link href="/apps" >See all apps</Link>
      </div>
    </div>

    {apps.map(app => (
      <HorizontalCard
      content={app}    
      />
      
    ))}
  </div>
 
  <div class="mt-12 animate">
    <div id="blogs" class="flex justify-between items-end w-full  mb-2">
      <span class="font-bold text-2xl sm:text-3xl">
        Blogs {"✒️"}
      </span>

      <div class=" text-lg text-gray-600 font-bold">
        <Link href="/blogs" >See all blogs</Link>
      </div>
    </div>

    {blogs.map(blog => (
      <HorizontalCard
      content={blog}
      />
    ))}
  </div>

  <div class="mt-12 animate">
    <div id="projects" class="flex justify-between items-end w-full  mb-2">
      <span class="font-bold text-2xl sm:text-3xl">
        Side Projects {"🧑‍💻"}
      </span>

      <div class=" text-lg text-gray-600 font-bold">
        <Link href="/projects" >See all projects</Link>
      </div>
    </div>

    {projects.map(project => (
      <HorizontalCard
      content={project}
      />
    ))}
  </div>

  
  <div class="animate mt-5">
    <CvSection />
  </div>
</BaseLayout>

