---
import Link from "@components/Link.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

---

<BaseLayout>
  <div class="pb-12 mt-5 animate" id="home">
    <div class="text-xl py-1 ">Hey there 👋</div>
    <div class="text-5xl font-bold ">I'm Mihai</div>
    <div class="text-3xl py-3 font-bold ">Full-Stack Developer</div>
    <div class="py-2">
      <p class="">
        I'm a Software Developer on the AI Innovation team at Marsh McLennan, and in my free time, I love building tools that make life easier, like:
        <span class="block">
          ✨ <Link href="https://video-repurpose.com">
            𝗩𝗶𝗱𝗲𝗼-𝗥𝗲𝗽𝘂𝗿𝗽𝗼𝘀𝗲.𝗰𝗼𝗺
          </Link>
          – Convert your videos into blogs, newsletters, and social media posts in minutes. 
        </span>
        <span class="block">
          🎬 <Link href="https://moviepicker.app">𝗠𝗼𝘃𝗶𝗲𝗣𝗶𝗰𝗸𝗲𝗿.𝗮𝗽𝗽</Link> 
           – Find a movie to watch in seconds, not hours. 
        </span>
    </div>
  </div>

  <div>
    <div id="projects" class="animate text-3xl w-full font-bold mb-2">
      My Apps {"</>"}
    </div>

    {projects.slice(0,2).map(project => (
      <HorizontalCard
      project={project}
      classNames="animate"
      
      />
      <div class="divider my-0"></div>
    ))}
  </div>
 
  <div class="mt-12 animate">
    <div id="projects" class="flex justify-between items-end w-full  mb-2">
      <span class="font-bold text-3xl">
        Side Projects {"🧑‍💻"}
      </span>

      <div class=" text-lg text-gray-600 font-bold  animate-pulse">
        <Link href="/projects" >See all projects</Link>
      </div>
    </div>

    <!-- {projects.slice(2,projects.length).map(project => (
      <HorizontalCard
      project={project}
      />
      <div class="divider my-0"></div>
    ))} -->
  </div>

  
  <!-- <div class="mt-5">
    <CvSection />
  </div> -->
</BaseLayout>

