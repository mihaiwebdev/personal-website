---
import BackToPrev from "@components/BackToPrev.astro";
import HorizontalCard from "@components/HorizontalCard.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout>
  <div class="pb-12 mt-5" id="projects">
    <div class="text-5xl font-bold"> Side Projects {"🧑‍💻"}</div>
    <div class="py-2">
      <p class="">
        These are some of the projects I have built over time for the purpose of learning. Some include links to the live app, while others link to a demo.
    </div>
  </div>


  <BackToPrev  variant="outline" className="mb-5">
    Back to home
  </BackToPrev>
  
  <HorizontalCard
    title="Recipe Finder - AI-Powered"
    img="/recipe-finder.png"
    desc="A Next.js app where you just describe what you want to eat, and AI gives you 5 recipe ideas with images to match."
    url="https://www.youtube.com/watch?v=fwmlO7JydyM"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Pathfinding Visualizer App"
    img="/pathfinding-1.png"
    desc="Developed an interactive visual interface for demonstrating three search algorithms, featuring maze generation, mouse-enabled wall drawing, adjustable start and end points, and pathfinding algorithm selection"
    url="https://celadon-monstera-509a49.netlify.app/"
  />

    <div class="divider my-0"></div>
  <HorizontalCard
    title="AI Code Challenge App"
    img="/ai-code-challenge.png"
    desc="Developed a game utilizing AI to generate code snippets and evaluate user responses to determine correctness. Built with OpenAI, TypeScript, Angular, SCSS, Node and Express"
    url="https://ai-guess-code-output-production.up.railway.app/"
  />

  <div class="divider my-0"></div>
  <HorizontalCard
    title="Home Services Platform"
    img="/home-services.png"
    desc="Created a platform to facilitate collaboration between workers and clients, offering distinct views for each user role. Implemented using React.js, TailwindCSS, React-Redux on the frontend, and Node.js, Express.js, MongoDB, and AWS for the backend"
    url="https://www.youtube.com/watch?v=h3OgPVsbZ9E"
  />

  <div class="divider my-0"></div>
  <HorizontalCard
    title="Weather App"
    img="/weather-1.png"
    desc="Developed a weather application with a dynamic custom design based on the weather condition"
    url="https://weather-app-beryl-eta-62.vercel.app/"
  />

  <div class="divider my-0"></div>
  <HorizontalCard
    title="Kanban - Task Management App"
    img="/kanban1.jpg"
    desc="I have created a task management app where you can register, create boards and add tasks. The tasks are ordered by 3 columns: To do, Doing and Done and you can update their status as you move forward."
    url="https://www.youtube.com/watch?v=JNeIeC8haQE"
  />

  <div class="divider my-0"></div>
  <HorizontalCard
    title="Audiophile - E-commerce Website"
    img="/audiophile-thumbnail.jpeg"
    desc="I have created a visually appealing e-commerce website for a fictional brand called Audiophile, using React, TailwindCSS and Framer Motion"
    url="https://audiophile-website-sigma.vercel.app/"
  />

  <div class="divider my-0"></div>
  <HorizontalCard
    title="WebSavantHub Portfolio - Landing Page"
    img="/web-savant.jpg"
    desc="Built a responsive brand website with a custom design using React, TailwindCss and Framer Motion"
    url="https://web-savant.vercel.app/"
  />


</BaseLayout>

<script></script>
