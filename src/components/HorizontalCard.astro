---

import { Image } from "astro:assets";

import type { CollectionEntry } from "astro:content";

type Props = {
  project:  CollectionEntry<"projects">;
  classNames: string
}

const {  project,
  classNames
} = Astro.props;
---

<div
  class={`rounded-lg bg-base-100 hover:shadow-xl transition ease-in-out hover:scale-[102%] ${classNames}`}
>
  <a href={`/${project.collection}/${project.slug}`}>
    <div class="hero-content flex-col md:flex-row">
      {
        project.data.img && (
          <Image
            src={project.data.img}
            width={750}
            height={422}
            format="webp"
            alt={project.data.title}
            class="max-w-full md:max-w-[13rem] rounded-lg"
          />
        )
      }
      <div class="grow w-full">
        <h1 class="text-xl font-bold">
          {project.data.title}
          {project.data.badge && <div class={`badge ${project.data.badgeColor} mx-2 ${project.data.badgeTextColor} ${project.data.badgeAnimation}`}>{project.data.badge}</div>}
        </h1>
        <p class="py-1 text-1xl">{project.data.description}</p>
      </div>
    </div>
  </a>
</div>
