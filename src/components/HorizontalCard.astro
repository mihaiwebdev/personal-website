---

import { Image } from "astro:assets";

import type { CollectionEntry } from "astro:content";

type Props = {
  content:  CollectionEntry<"projects"> | CollectionEntry<"apps"> | CollectionEntry<"blogs"> ;
  classNames?: string
}

const {  content,
  classNames
} = Astro.props;
---

<div class="animate">
  <div
  class={`rounded-lg bg-base-100 hover:shadow-xl transition ease-in-out hover:scale-[102%]  `}
  >
  <a href={`/${content.collection}/${content.slug}`}>
    <div class="hero-content flex-col md:flex-row">
      {
        content.data.img && (
          <Image
          src={content.data.img}
          width={750}
          height={422}
          format="webp"
          alt={content.data.title}
          class="max-w-full md:max-w-[13rem] rounded-lg"
          />
        )
      }
      <div class="grow w-full">
        <h1 class="text-xl font-bold">
          {content.data.title}
          {content.data.badge && <div class={`badge ${content.data.badgeColor} mx-2 ${content.data.badgeTextColor} ${content.data.badgeAnimation}`}>{content.data.badge}</div>}
        </h1>
        <p class="py-1 text-1xl">{content.data.description}</p>
      </div>
    </div>
  </a>
</div>
<div class="divider my-0"></div>
</div>