---
import { cn } from "@lib/utils";

type Props = {
  href: string;
  external?: boolean;
  underline?: boolean;
}

const { href, external, underline = true, ...rest } = Astro.props;
---

<a 
  href={href} 
  target={ external ? "_blank" : "_self" } 
  class={"inline-block transition-colors hover:text-gray-400 duration-300 ease-in-out underline  underline-offset-2"}
  {...rest}>
  <slot/>
</a>
