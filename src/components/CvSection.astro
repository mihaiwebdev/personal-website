---
import TimeLineElement from "./cv/TimeLine.astro";
---

<div id="work" class="mb-5 mt-10">
  <div class="text-2xl sm:text-3xl w-full font-bold">Work</div>
</div>

<div class="time-line-container mb-10">
  <TimeLineElement
    title="Full-Stack Developer: AI Innovation"
    subtitle="From Dec 2024 - Present at Marsh Mclennan, Remote"
  >
    <p class="mb-5">
      Part of the AI innovation team, developing and maintaining AI-powered applications, building PoCs and MVPs to streamline workflows and enhance daily productivity.
    </p>
    
  </TimeLineElement>

  <TimeLineElement
    title="Front-End Developer"
    subtitle="From Jul 2023 - November 2024 at Accesa.eu, Remote"
  >
    <p class="mb-5">
      Developed and maintained Angular applications, modernizing the codebase and improving performance while ensuring smooth user experiences.
    </p>
    
  </TimeLineElement>

  <TimeLineElement
    title="Full-Stack Developer - Freelance"
    subtitle="From Mar 2023 - May 2023 on Upwork, Remote"
  >
   <p class="mb-5">
    Built an e-commerce website for a bookstore, enhancing user engagement, streamlining order management, and improving content management efficiency.
   </p>
  </TimeLineElement>
</div>

