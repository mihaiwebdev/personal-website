---
const activeClass = "bg-base-300";
const currentPath = Astro.url.pathname;
---

<ul class="menu grow shrink menu-md overflow-y-auto">
  <li>
    <a 
      href="/" 
      class:list={["py-3 text-base nav-link", { [activeClass]: currentPath === "/" }]} 
      id="home-link"
    >
      Home
    </a>
  </li>

  <li>
    <a 
      href="/apps" 
      class:list={["py-3 text-base nav-link", { [activeClass]: currentPath.startsWith("/apps") }]} 
      id="apps-link"
    >
      Apps
    </a>
  </li>


  <li>
    <a 
      href="/blogs" 
      class:list={["py-3 text-base nav-link", { [activeClass]: currentPath.startsWith("/blogs")}]} 
      id="blogs-link"
    >
      Blogs
    </a>
  </li>

  <li>
    <a 
      href="/projects" 
      class:list={["py-3 text-base nav-link", { [activeClass]: currentPath.startsWith("/projects") }]} 
      id="projects-link"
    >
      Side Projects
    </a>
  </li>

  <li>
    <a 
      href="/#work" 
      class:list={["py-3 text-base nav-link"]} 
      id="work-link"
    >
      Work
    </a>
  </li>
</ul>

